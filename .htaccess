# セキュリティ設定

# テキストファイルへの直接アクセスを制限
<Files "*.txt">
    Require all denied
</Files>

# robots.txt はクローラへ公開する（上の *.txt 拒否を打ち消す）
<Files "robots.txt">
    Require all granted
</Files>

# 共通ライブラリへの直接アクセスを制限
<Files "session_boot.php">
    Require all denied
</Files>

# PHP設定ファイルへの直接アクセスを制限
<Files ".user.ini">
    Require all denied
</Files>

# ディレクトリリスト表示を無効化
Options -Indexes

# セキュリティヘッダーの設定
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
    Header always set Referrer-Policy strict-origin-when-cross-origin
</IfModule>

# PHP設定（モジュール版でのみ有効）
# CGI/FastCGI環境には mod_php が無く、囲わない php_value は500の原因になる。
# 同じ内容を .user.ini にも置き、session関連は session_boot.php で指定する。
<IfModule mod_php.c>
    # PHPエラー表示を無効化
    php_flag display_errors Off
    php_flag log_errors On

    # ファイルアップロード制限
    php_value upload_max_filesize 1M
    php_value post_max_size 1M
</IfModule>
